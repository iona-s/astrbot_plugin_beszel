{
  "beszel": {
    "description": "Beszel Hub",
    "type": "object",
    "items": {
      "base_url": {"type": "string", "description": "Beszel Hub 地址", "default": "http://127.0.0.1:8090"},
      "email": {"type": "string", "description": "登录用户邮箱", "hint": "用于登录 Beszel Hub的账号，建议创建仅有读取权限的账号", "default": ""},
      "password": {
        "type": "string",
        "description": "登录用户密码",
        "hint": "用于登录 Beszel Hub的密码",
        "default": ""
      },
      "timeout_seconds": {"type": "int", "description": "请求超时（秒）", "default": 10, "slider": {"min": 2, "max": 60, "step": 1}},
      "verify_tls": {"type": "bool", "description": "验证 TLS 证书", "default": true},
      "history_default_range": {"type": "string", "description": "默认历史范围", "options": ["1h", "12h", "24h", "1w", "30d"], "default": "1h"},
      "cache_ttl_seconds": {"type": "int", "description": "探针列表缓存时长（秒）", "hint": "缓存探针列表以减少 Hub 请求；设为 0 即禁用缓存", "default": 60, "slider": {"min": 0, "max": 300, "step": 5}}
    }
  },
  "access": {
    "description": "查询访问控制",
    "type": "object",
    "items": {
      "mode": {"type": "string", "description": "访问模式", "options": ["admin_only", "umo_allowlist", "all"], "default": "admin_only"},
      "allowed_umos": {"type": "list", "description": "允许的完整 UMO", "items": {"type": "string"}, "default": []}
    }
  },
  "display": {
    "description": "时间显示",
    "type": "object",
    "items": {
      "timezone": {
        "type": "string",
        "description": "显示时区（留空继承 AstrBot）",
        "hint": "IANA 时区名称，例如 Asia/Shanghai",
        "default": ""}
    }
  },
  "render": {
    "description": "图片渲染",
    "type": "object",
    "items": {
      "page_size": {"type": "int", "description": "概览每页系统数", "default": 20, "slider": {"min": 10, "max": 40, "step": 1}},
      "show_connection_address": {"type": "bool", "description": "详情显示连接地址", "default": false},
      "font_path": {
        "type": "string",
        "description": "自定义字体文件路径（留空使用内置字体）",
        "hint": "填写 AstrBot 运行环境内可访问的 TTF、TTC、OTF、WOFF 或 WOFF2 字体文件路径；加载失败时回退到内置字体",
        "default": ""
      },
      "container_history_threshold": {
        "type": "int",
        "description": "容器历史过滤阈值（%）",
        "hint": "容器该时间段峰值低于图表 Y 轴最大值此百分比时不绘制，会至少保留一个峰值最高的容器；0 为全显示，建议设置为 10-20",
        "default": 10,
        "slider": {"min": 0, "max": 50, "step": 1}
      },
      "render_scale": {
        "type": "int",
        "description": "图片渲染精细度（%）",
        "hint": "图片渲染分辨率缩放比例；100 为标准精细度，调高可提升清晰度但增加资源占用，调低则反之",
        "default": 100,
        "slider": {"min": 50, "max": 300, "step": 5}
      }
    }
  },
  "webhook": {
    "description": "Webhook",
    "type": "object",
    "items": {
      "enabled": {"type": "bool", "description": "启用 Webhook", "default": false},
      "host": {"type": "string", "description": "监听地址", "default": "127.0.0.1"},
      "port": {"type": "int", "description": "监听端口", "default": 8899, "slider": {"min": 1, "max": 65535, "step": 1}},
      "path": {"type": "string", "description": "通知路径", "default": "/"},
      "token": {
        "type": "string",
        "description": "Bearer token（启用后留空自动生成）",
        "hint": "仅支持 ASCII 字符；留空时将在启用后自动生成安全令牌",
        "default": ""
      },
      "target_umos": {"type": "list", "description": "通知目标 UMO", "items": {"type": "string"}, "default": []},
      "analysis_provider_id": {
        "type": "string",
        "description": "AI 诊断使用的模型（留空使用目标会话模型）",
        "hint": "留空或所选模型不可用时，按顺序使用第一个能取到模型的通知目标会话当前的对话模型",
        "_special": "select_provider",
        "default": ""
      },
      "analysis_prompt": {
        "type": "text",
        "description": "自定义 AI 根因分析提示词（留空使用默认）",
        "hint": "非空时完全替换默认 System Prompt，留空时使用插件内置提示词，最长 4096 字符",
        "default": ""
      },
      "analysis_timeout_seconds": {
        "type": "int",
        "description": "AI 诊断超时时间（秒）",
        "hint": "单次模型调用的超时时间，范围 1 到 300 秒",
        "default": 60
      },
      "analysis_context_hours": {
        "type": "int",
        "description": "AI 诊断关联历史的最长时间（小时）",
        "hint": "同一节点在此时间内的诊断会作为后续告警诊断的上下文；0 关闭关联，范围 0 到 168",
        "default": 24
      },
      "analysis_context_recent_hours": {
        "type": "int",
        "description": "AI 诊断完整附带历史的近期时间（小时）",
        "hint": "此时间内同一节点的诊断全部附带，没有时只附带最长时间内的最近一条；范围 0 到 168，超过最长时间时按最长时间处理",
        "default": 6
      },
      "analysis_context_max_records": {
        "type": "int",
        "description": "AI 诊断最多附带的历史条数",
        "hint": "每个节点最多保留并附带的诊断条数，每条约增加 150~300 token 输入；范围 1 到 20",
        "default": 8
      }
    }
  }
}
