    }
  },
  "plain_text": {
    "content_type": "text/plain",
    "headers": {},
    "body": "Fixture plain text notification"
  },
  "malformed_json": {
    "content_type": "application/json",
    "headers": {},
    "body": {"title": "Missing message"}
  },
  "unsupported_media": {
