{
  "auth": {
    "token": "fixture-webhook-token",
    "valid": "Bearer fixture-webhook-token",
    "invalid": "Bearer wrong-fixture-token",
    "non_ascii": "Bearer 令牌-token",
    "non_ascii_token": "非ASCII令牌",
    "missing": ""
  },
  "server": {"path": "/notify", "denied_origin": "fixture:denied", "fallback_origin": "fixture:origin"},
  "request_ids": {
    "generic": "fixture-generic",
    "uptime": "fixture-uptime",
    "plain": "fixture-plain",
    "history": "fixture-history",
    "invalid": "fixture-invalid"
  },
  "delivery_notification": {
    "title": "Fixture Delivery Title",
    "message": "Synthetic delivery notification message",
    "history_system_id": "pubatlas0000001",
    "request_id": "fixture-delivery"
  },
  "generic_json": {
    "content_type": "application/json; charset=utf-8",
    "headers": {"X-Webhook-Source": "generic"},
    "body": {
      "title": "Fixture alert",
      "message": "Synthetic notification body",
      "send_history": "true"
    }
  },
  "beszel_history": {
    "content_type": "application/json",
    "headers": {},
    "body": {
      "source": "beszel",
      "title": "Atlas Gateway threshold exceeded",
      "message": "Open /system/pubatlas0000001 for details",
      "send_history": true
    }
  },
  "beszel_analysis": {
    "content_type": "application/json",
    "headers": {},
    "body": {
      "source": "beszel",
      "title": "Atlas Gateway threshold exceeded",
      "message": "Open /system/pubatlas0000001 for details",
      "send_analysis": true
    }
  },
  "generic_both": {
    "content_type": "application/json",
    "headers": {"X-Webhook-Source": "generic"},
    "body": {
      "title": "Atlas alert",
      "message": "Open /system/pubatlas0000001 for details",
      "send_history": "true",
      "send_analysis": true
    }
  },
  "uptime_kuma": {
    "content_type": "application/json",
    "headers": {},
    "body": {
      "heartbeat": {"status": 0},
      "monitor": {"name": "Fixture API"},
      "msg": "Connection failed"
    }
  },
  "plain_text": {
    "content_type": "text/plain",
    "headers": {},
    "body": "Fixture plain text notification"
  },
  "malformed_json": {
    "content_type": "application/json",
    "headers": {},
    "body": {"title": "Missing message"}
  },
  "unsupported_media": {
    "content_type": "multipart/form-data; boundary=fixture",
    "headers": {},
    "body": "field=value"
  },
  "system_matching": [
    {
      "case": "a matching title without a link does not bind",
      "source": "beszel",
      "systems": {"fixture-atlas": "Atlas"},
      "title": "Atlas CPU above threshold",
      "message": "Fixture alert without a link",
      "expected": null
    },
    {
      "case": "an unknown link does not bind",
      "source": "beszel",
      "systems": {"fixture-atlas": "Atlas"},
      "title": "Atlas CPU above threshold",
      "message": "Open /system/fixture-hidden for details",
      "expected": null
    },
    {
      "case": "a later link may carry the known ID",
      "source": "beszel",
      "systems": {"fixture-atlas": "Atlas"},
      "title": "Fixture alert",
      "message": "See /system/fixture-hidden and /system/fixture-atlas",
      "expected": "fixture-atlas"
    },
    {
      "case": "shoutrrr source binds a known link",
      "source": "shoutrrr",
      "systems": {"fixture-atlas": "Atlas"},
      "title": "Fixture alert",
      "message": "Open /system/fixture-atlas for details",
      "expected": "fixture-atlas"
    }
  ],
  "bom_json": {
    "content_type": "application/json",
    "headers": {},
    "body": {
      "source": "beszel",
      "title": "Fixture BOM alert",
      "message": "Synthetic notification body",
      "send_history": true,
      "send_analysis": "true"
    }
  },
  "hostile_json": {"integer_digits": 5000, "nesting_depth": 8000},
  "escaped_cjk": {
    "content_type": "application/json",
    "headers": {},
    "title": "Fixture escaped alert",
    "message_unit": "告警",
    "message_repeat": 2500
  }
}
