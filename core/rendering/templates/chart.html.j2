{% macro chart_card(view) -%}
<div class="chart-card">
  <div class="chart-title-row">
    <span class="chart-title">{{ view.card.title }}</span>
    <span class="chart-current">当前: {{ view.current_label }}</span>
  </div>
  <div class="chart-subtitle">{{ view.card.subtitle }}</div>
  {% if view.geometry %}
  {# Pytakumi needs SVG paint as attributes, renders no SVG <text>, and card backgrounds cover absolute children: axis labels stay in normal flow. #}
  <div class="chart-body">
    <div class="chart-y-axis" style="width: {{ view.geometry.y_axis_width }}px">
      {% for line in view.geometry.grid_lines | reverse %}
      <span class="chart-y-label">{{ line.label }}</span>
      {% endfor %}
    </div>
    <svg class="chart" viewBox="0 0 {{ view.geometry.width }} {{ view.geometry.height }}" width="{{ view.geometry.width }}" height="{{ view.geometry.height }}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ view.card.title }}">
      <defs>
        {% for segment in view.geometry.segments %}
        <linearGradient id="{{ segment.grad_id }}" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="{{ segment.color | color_css }}" stop-opacity="0.20" />
          <stop offset="100%" stop-color="{{ segment.color | color_css }}" stop-opacity="0.20" />
        </linearGradient>
        {% endfor %}
      </defs>
      {% for line in view.geometry.grid_lines %}
      <line class="chart-grid-line" x1="{{ view.geometry.plot_left }}" y1="{{ line.y | coord }}" x2="{{ view.geometry.plot_right }}" y2="{{ line.y | coord }}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="{% if not loop.last %}3 3{% else %}0{% endif %}" />
      {% endfor %}
      {% for segment in view.geometry.segments %}
        {% if segment.area_path %}<path class="chart-area" d="{{ segment.area_path }}" fill="url(#{{ segment.grad_id }})" />{% endif %}
        {% if segment.line_path %}<path class="chart-line" d="{{ segment.line_path }}" fill="none" stroke="{{ segment.color | color_css }}" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />{% endif %}
        {% for marker in segment.markers %}<circle class="chart-marker" cx="{{ marker.x | coord }}" cy="{{ marker.y | coord }}" r="2" fill="{{ segment.color | color_css }}" />{% endfor %}
      {% endfor %}
    </svg>
  </div>
  <div class="chart-x-axis" style="margin-left: {{ view.geometry.y_axis_width }}px; width: {{ view.geometry.width }}px">
    {% for tick in view.geometry.ticks %}
    <span class="chart-tick-label chart-tick-{{ tick.anchor }}" style="margin-left: {{ tick.margin_left | coord }}px">{{ tick.label }}</span>
    {% endfor %}
  </div>
  {% else %}
  <div class="empty">暂无可用时序数据</div>
  {% endif %}
  {% if (view.card.series | length > 1) or view.card.extra_series_count > 0 %}
  <div class="legend">
    {% for series in view.card.series %}
    <span class="legend-item"><span class="legend-dot" style="background: {{ series.color | color_css }}"></span>{{ series.name }}</span>
    {% endfor %}
    {% if view.card.extra_series_count > 0 %}
    <span class="legend-more">+{{ view.card.extra_series_count }}</span>
    {% endif %}
  </div>
  {% endif %}
</div>
{%- endmacro %}
