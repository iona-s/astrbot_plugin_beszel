{% macro header(header) -%}
<div class="header">
  <div class="header-left">
    {{ logo() }}
    <div class="header-titles">
      <div class="header-title">{{ header.title }}</div>
      {% if header.subtitle %}<div class="header-subtitle">{{ header.subtitle }}</div>{% endif %}
    </div>
  </div>
  {% if header.status or header.metadata %}
  <div class="header-right">
    {% if header.status %}
    <div class="header-status-row">
      <span class="chip status-chip status-{{ header.status.state }}">
        <span class="status-dot status-dot-{{ header.status.state }}"></span>
        {{ header.status.label }}
      </span>
    </div>
    {% endif %}
    {% if header.metadata %}
    <div class="header-meta-row">
      {% for item in header.metadata %}
      <span class="chip"><span class="chip-label">{{ item.label }}:</span> {{ item.value }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{%- endmacro %}

{% macro history_info_bar(header) -%}
<div class="info-bar-card">
  <div class="info-bar-header">
    <div class="info-bar-left">
      {{ logo() }}
      <div class="info-bar-titles">
        <div class="info-title">{{ header.title }}</div>
        <div class="info-meta-row">
          {% if header.status %}
          <span class="info-item">
            <span class="status-dot status-dot-{{ header.status.state }}"></span>
            {{ header.status.label }}
          </span>
          {% endif %}
          {% if header.connection_address %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            {{ header.connection_address }}
          </span>
          {% endif %}
          {% if header.uptime_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.228 21.925A10 10 0 1 1 21.994 12.338"></path><path d="M12 6v6l1.562.781"></path><path d="m14 18 4-4 4 4"></path><path d="M18 22v-8"></path></svg>
            {{ header.uptime_text }}
          </span>
          {% endif %}
          {% if header.os_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 256 256" fill="#64748b"><path d="M231 217a12 12 0 0 1-16-2c-2-1-35-44-35-127a52 52 0 1 0-104 0c0 83-33 126-35 127a12 12 0 0 1-18-14c0-1 29-39 29-113a76 76 0 1 1 152 0c0 74 29 112 29 113a12 12 0 0 1-2 16m-127-97a16 16 0 1 0-16-16 16 16 0 0 0 16 16m64-16a16 16 0 1 0-16 16 16 16 0 0 0 16-16m-73 51 28 12a12 12 0 0 0 10 0l28-12a12 12 0 0 0-10-22l-23 10-23-10a12 12 0 0 0-10 22m33 29a57 57 0 0 0-39 15 12 12 0 0 0 17 18 33 33 0 0 1 44 0 12 12 0 1 0 17-18 57 57 0 0 0-39-15"></path></svg>
            {{ header.os_text }}
          </span>
          {% endif %}
          {% if header.cpu_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"></path></svg>
            {{ header.cpu_text }}
          </span>
          {% endif %}
          {% if header.memory_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 19v-3M10 19v-3M14 19v-3M18 19v-3M8 11V9M16 11V9M12 11V9M2 15h20M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1.1a2 2 0 0 0 0 3.8V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.1a2 2 0 0 0 0-3.8Z"></path></svg>
            {{ header.memory_text }}
          </span>
          {% endif %}
          {% if not (header.connection_address or header.uptime_text or header.os_text or header.cpu_text or header.memory_text) %}
          {% for item in header.metadata %}
          <span class="info-divider"></span>
          <span class="info-item">{{ item.label }}: {{ item.value }}</span>
          {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
    {% if header.range_label %}
    <div class="range-display">
      <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>
      <span>{{ header.range_label }}</span>
    </div>
    {% endif %}
  </div>
</div>
{%- endmacro %}

{% macro progress_metric(metric) -%}
<div class="metric">
  <div class="metric-label-row">
    <span class="metric-label">{{ metric.label }}</span>
    <span class="metric-value">{{ metric.value_text }}</span>
  </div>
  {% if metric.secondary_text %}<div class="metric-secondary">{{ metric.secondary_text }}</div>{% endif %}
  <div class="track">
    <div class="fill" style="background: {{ metric.color | color_css }}; width: {{ metric.value | percentage_width(metric.maximum) }}"></div>
  </div>
</div>
{%- endmacro %}

{% macro overview_card(card) -%}
<div class="overview-card">
  <div class="card-head">
    <div class="card-name">
      <span class="status-dot status-dot-{{ card.status.state }}"></span>
      <span>{{ card.name }}</span>
      {% if card.agent_version %}<span class="version-chip">{{ card.agent_version }}</span>{% endif %}
    </div>
    {% if card.updated_text %}<div class="card-updated">{{ card.updated_text }}</div>{% endif %}
  </div>
  <div class="card-body">
    {% if card.metadata %}
    <div class="card-meta-bar">
      {% for item in card.metadata %}
      <span class="meta-pill"><span class="meta-pill-label">{{ item.label }}:</span> <span class="meta-pill-val">{{ item.value }}</span></span>
      {% endfor %}
    </div>
    {% endif %}
    <div class="metric-list">
      {% for metric in card.metrics %}{{ progress_metric(metric) }}{% endfor %}
    </div>
  </div>
</div>
{%- endmacro %}

{% macro metric_card(card) -%}
<div class="metric-card">
  <div class="metric-card-label">{{ card.label }}</div>
  <div class="metric-card-value">{{ card.value_text }}</div>
  {% if card.value is not none and card.maximum > 0 %}
  <div class="track metric-card-track">
    <div class="fill" style="background: {{ card.color | color_css }}; width: {{ card.value | percentage_width(card.maximum) }}"></div>
  </div>
  {% endif %}
  {% if card.secondary_text %}<div class="metric-card-secondary">{{ card.secondary_text }}</div>{% endif %}
</div>
{%- endmacro %}

{% macro detail_section(section) -%}
<div class="section-card">
  <div class="section-head">
    <div class="section-title">{{ section.title }}</div>
  </div>
  <div class="section-body">
    {% for row in section.rows %}
    <div class="section-row">
      <span class="section-label">{{ row.label }}</span>
      {% if row.percent is not none %}
      <div class="disk-track">
        <div class="disk-fill" style="background: {{ row.color | color_css if row.color else '#22c55e' }}; width: {{ row.percent | percentage_width(100.0) }}"></div>
      </div>
      {% endif %}
      <span class="section-value">{{ row.value }}</span>
    </div>
    {% else %}
    <div class="empty">暂无可用数据</div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}

{% macro container_section(containers) -%}
<div class="section-card">
  <div class="section-head">
    <div class="section-title">Docker 容器 ({{ containers | length }})</div>
  </div>
  <div class="container-grid">
    <div class="container-th-row">
      <span class="container-col-name">名称</span>
      <span class="container-col-cpu">CPU 占用</span>
      <span class="container-col-mem">内存占用</span>
    </div>
    {% for c in containers %}
    <div class="container-tr-row">
      <span class="container-col-name container-name-text">{{ c.name }}</span>
      <span class="container-col-cpu tabular-nums">{{ c.cpu_text }}</span>
      <span class="container-col-mem tabular-nums">{{ c.memory_text }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}
