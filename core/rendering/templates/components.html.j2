{% macro header(header) -%}
<div class="header">
  <div class="header-left">
    {{ logo() }}
    <div class="header-titles">
      <div class="header-title">{{ header.title }}</div>
      {% if header.subtitle %}<div class="header-subtitle">{{ header.subtitle }}</div>{% endif %}
    </div>
  </div>
  {% if header.status or header.metadata %}
  <div class="header-right">
    {% if header.status %}
    <div class="header-status-row">
      <span class="chip status-chip status-{{ header.status.state }}">
        <span class="status-dot status-dot-{{ header.status.state }}"></span>
        {{ header.status.label }}
      </span>
    </div>
    {% endif %}
    {% if header.metadata %}
    <div class="header-meta-row">
      {% for item in header.metadata %}
      <span class="chip"><span class="chip-label">{{ item.label }}:</span> {{ item.value }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{%- endmacro %}

{% macro history_info_bar(header) -%}
<div class="info-bar-card">
  <div class="info-bar-header">
    <div class="info-bar-left">
      {{ logo() }}
      <div class="info-bar-titles">
        <div class="info-title">{{ header.title }}</div>
        <div class="info-meta-row">
          {% if header.status %}
          <span class="info-item">
            <span class="status-dot status-dot-{{ header.status.state }}"></span>
            {{ header.status.label }}
          </span>
          {% endif %}
          {% if header.connection_address %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            {{ header.connection_address }}
          </span>
          {% endif %}
          {% if header.uptime_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.228 21.925A10 10 0 1 1 21.994 12.338"></path><path d="M12 6v6l1.562.781"></path><path d="m14 18 4-4 4 4"></path><path d="M18 22v-8"></path></svg>
            {{ header.uptime_text }}
          </span>
          {% endif %}
          {% if header.os_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 256 256" fill="#64748b"><path d="M231 217a12 12 0 0 1-16-2c-2-1-35-44-35-127a52 52 0 1 0-104 0c0 83-33 126-35 127a12 12 0 0 1-18-14c0-1 29-39 29-113a76 76 0 1 1 152 0c0 74 29 112 29 113a12 12 0 0 1-2 16m-127-97a16 16 0 1 0-16-16 16 16 0 0 0 16 16m64-16a16 16 0 1 0-16 16 16 16 0 0 0 16-16m-73 51 28 12a12 12 0 0 0 10 0l28-12a12 12 0 0 0-10-22l-23 10-23-10a12 12 0 0 0-10 22m33 29a57 57 0 0 0-39 15 12 12 0 0 0 17 18 33 33 0 0 1 44 0 12 12 0 1 0 17-18 57 57 0 0 0-39-15"></path></svg>
            {{ header.os_text }}
          </span>
          {% endif %}
          {% if header.cpu_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"></path></svg>
            {{ header.cpu_text }}
          </span>
          {% endif %}
          {% if header.memory_text %}
          <span class="info-divider"></span>
          <span class="info-item">
            <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 19v-3M10 19v-3M14 19v-3M18 19v-3M8 11V9M16 11V9M12 11V9M2 15h20M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1.1a2 2 0 0 0 0 3.8V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.1a2 2 0 0 0 0-3.8Z"></path></svg>
            {{ header.memory_text }}
          </span>
          {% endif %}
          {% if not (header.connection_address or header.uptime_text or header.os_text or header.cpu_text or header.memory_text) %}
          {% for item in header.metadata %}
          <span class="info-divider"></span>
          <span class="info-item">{{ item.label }}: {{ item.value }}</span>
          {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
    {% if header.range_label %}
    <div class="range-display">
      <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg>
      <span>{{ header.range_label }}</span>
    </div>
    {% endif %}
  </div>
</div>
{%- endmacro %}

{% macro progress_metric(metric) -%}
<div class="metric">
  <div class="metric-label-row">
    <span class="metric-label">{{ metric.label }}</span>
    <span class="metric-value">{{ metric.value_text }}</span>
  </div>
  {% if metric.secondary_text %}<div class="metric-secondary">{{ metric.secondary_text }}</div>{% endif %}
  <div class="track">
    <div class="fill" style="background: {{ metric.color | color_css }}; width: {{ metric.value | percentage_width(metric.maximum) }}"></div>
  </div>
</div>
{%- endmacro %}

{% macro overview_table(rows) -%}
<div class="section-card overview-table-card">
  <div class="overview-table-grid">
    <div class="overview-table-th-row">
      <div class="th-cell col-sys">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>
        <span>系统</span>
      </div>
      <div class="th-cell col-metric">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"></rect><rect width="6" height="6" x="9" y="9" rx="1"></rect><path d="M15 2v2"></path><path d="M15 20v2"></path><path d="M2 15h2"></path><path d="M2 9h2"></path><path d="M20 15h2"></path><path d="M20 9h2"></path><path d="M9 2v2"></path><path d="M9 20v2"></path></svg>
        <span>CPU</span>
      </div>
      <div class="th-cell col-metric">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 19v-3"></path><path d="M10 19v-3"></path><path d="M14 19v-3"></path><path d="M18 19v-3"></path><path d="M8 11V9"></path><path d="M16 11V9"></path><path d="M12 11V9"></path><path d="M2 15h20"></path><path d="M2 7a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v1.1a2 2 0 0 0 0 3.837V17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-5.1a2 2 0 0 0 0-3.837Z"></path></svg>
        <span>内存</span>
      </div>
      <div class="th-cell col-metric">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="2" y1="12" y2="12"></line><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path><line x1="6" x2="6.01" y1="16" y2="16"></line><line x1="10" x2="10.01" y1="16" y2="16"></line></svg>
        <span>磁盘</span>
      </div>
      <div class="th-cell col-load">
        <svg class="col-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M4 2h16v4.5L13.5 12l6.5 5.5V22H4v-4.5l6.5-5.5L4 6.5zm12.3 5L18 5.5V4H6v1.5L7.7 7zM12 13.3l-6 5.2V20h1l5-3 5 3h1v-1.5z"></path></svg>
        <span>负载</span>
      </div>
      <div class="th-cell col-net">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 20 3-3h2a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h2l3 3zM6 8v1m4-1v1m4-1v1m4-1v1"></path></svg>
        <span>网络</span>
      </div>
      <div class="th-cell col-svc">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 11 2-2-2-2"></path><path d="M11 13h4"></path><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect></svg>
        <span>服务</span>
      </div>
      <div class="th-cell col-uptime">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.228 21.925A10 10 0 1 1 21.994 12.338"></path><path d="M12 6v6l1.562.781"></path><path d="m14 18 4-4 4 4"></path><path d="M18 22v-8"></path></svg>
        <span>运行时间</span>
      </div>
      <div class="th-cell col-agent">
        <svg class="col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01"></path><path d="M2 8.82a15 15 0 0 1 20 0"></path><path d="M5 12.859a10 10 0 0 1 14 0"></path><path d="M8.5 16.429a5 5 0 0 1 7 0"></path></svg>
        <span>客户端</span>
      </div>
    </div>
    {% for row in rows %}
    <div class="overview-table-tr-row {{ 'row-offline' if row.status_state != 'up' else '' }}">
      <div class="td-cell col-sys">
        <span class="status-dot status-dot-{{ row.status_state }}"></span>
        <span class="sys-name">{{ row.name }}</span>
      </div>
      <div class="td-cell col-metric">
        <span class="metric-val tabular-nums">{{ row.cpu_text }}</span>
        {% if row.cpu_percent is not none and row.status_state == 'up' %}
        <div class="table-meter-track">
          <div class="table-meter-fill" style="background: {{ row.cpu_color | color_css }}; width: {{ row.cpu_percent | percentage_width(100.0) }};"></div>
        </div>
        {% endif %}
      </div>
      <div class="td-cell col-metric">
        <span class="metric-val tabular-nums">{{ row.memory_text }}</span>
        {% if row.memory_percent is not none and row.status_state == 'up' %}
        <div class="table-meter-track">
          <div class="table-meter-fill" style="background: {{ row.memory_color | color_css }}; width: {{ row.memory_percent | percentage_width(100.0) }};"></div>
        </div>
        {% endif %}
      </div>
      <div class="td-cell col-metric">
        <span class="metric-val tabular-nums">{{ row.disk_text }}</span>
        {% if row.disk_percent is not none and row.status_state == 'up' %}
        <div class="table-meter-track">
          <div class="table-meter-fill" style="background: {{ row.disk_color | color_css }}; width: {{ row.disk_percent | percentage_width(100.0) }};"></div>
        </div>
        {% endif %}
      </div>
      <div class="td-cell col-load">
        {% if row.load_text != '-' and row.load_state != 'none' %}
        <span class="status-dot status-dot-{{ row.load_state }}"></span>
        <span class="load-val tabular-nums">{{ row.load_text }}</span>
        {% else %}
        <span class="muted-dash">-</span>
        {% endif %}
      </div>
      <div class="td-cell col-net">
        <span class="tabular-nums {{ 'muted-dash' if row.network_text == '-' else '' }}">{{ row.network_text }}</span>
      </div>
      <div class="td-cell col-svc">
        {% if row.services_text != '-' and row.services_state != 'none' %}
        <span class="status-dot status-dot-{{ row.services_state }}"></span>
        <span class="tabular-nums">{{ row.services_text }}</span>
        {% else %}
        <span class="muted-dash">-</span>
        {% endif %}
      </div>
      <div class="td-cell col-uptime">
        <span class="tabular-nums">{{ row.uptime_text }}</span>
      </div>
      <div class="td-cell col-agent">
        <span class="agent-tag">{{ row.agent_version if row.agent_version else '-' }}</span>
      </div>
    </div>
    {% else %}
    <div class="overview-empty-row">当前没有可见探针</div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}

{% macro metric_card(card) -%}
<div class="metric-card">
  <div class="metric-card-label">{{ card.label }}</div>
  <div class="metric-card-value">{{ card.value_text }}</div>
  {% if card.value is not none and card.maximum > 0 %}
  <div class="track metric-card-track">
    <div class="fill" style="background: {{ card.color | color_css }}; width: {{ card.value | percentage_width(card.maximum) }}"></div>
  </div>
  {% endif %}
  {% if card.secondary_text %}<div class="metric-card-secondary">{{ card.secondary_text }}</div>{% endif %}
</div>
{%- endmacro %}

{% macro detail_section(section) -%}
<div class="section-card">
  <div class="section-head">
    <div class="section-title">{{ section.title }}</div>
  </div>
  <div class="section-body">
    {% for row in section.rows %}
    <div class="section-row">
      <span class="section-label">{{ row.label }}</span>
      {% if row.percent is not none %}
      <div class="disk-track">
        <div class="disk-fill" style="background: {{ row.color | color_css if row.color else '#22c55e' }}; width: {{ row.percent | percentage_width(100.0) }}"></div>
      </div>
      {% endif %}
      <span class="section-value">{{ row.value }}</span>
    </div>
    {% else %}
    <div class="empty">暂无可用数据</div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}

{% macro container_section(containers) -%}
<div class="section-card">
  <div class="section-head">
    <div class="section-title">Docker 容器 ({{ containers | length }})</div>
  </div>
  <div class="container-grid">
    <div class="container-th-row">
      <span class="container-col-name">名称</span>
      <span class="container-col-cpu">CPU 占用</span>
      <span class="container-col-mem">内存占用</span>
    </div>
    {% for c in containers %}
    <div class="container-tr-row">
      <span class="container-col-name container-name-text">{{ c.name }}</span>
      <span class="container-col-cpu tabular-nums">{{ c.cpu_text }}</span>
      <span class="container-col-mem tabular-nums">{{ c.memory_text }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{%- endmacro %}
